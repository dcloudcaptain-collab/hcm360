# Force LF line endings for shell scripts and Linux-bound config —
# avoids "/usr/bin/env\r: No such file or directory" on macOS / Linux
# and inside Docker containers when committed from Windows.
*.sh         text eol=lf
*.py         text eol=lf
*.sql        text eol=lf
Dockerfile   text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf

# Treat everything else with platform-default line endings
*            text=auto
